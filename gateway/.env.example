SERVICE_NAME=gateway
PORT=3010
INVENTARIO_URL=http://localhost:3011
VENTAS_URL=http://localhost:3012
CLIENTES_URL=http://localhost:3013
GATEWAY_TIMEOUT_MS=15000
CORS_ORIGINS=http://localhost:3014
LOG_JSON=false
# Secreto de firma JWT (mínimo 32 caracteres aleatorios)
JWT_SECRET=reemplaza-por-un-secreto-aleatorio-de-al-menos-32-caracteres
JWT_EXPIRES_IN_SEGUNDOS=28800
# Usuario administrador. El hash se genera con: npm run hash-password -- "tu contraseña"
ADMIN_USUARIO=admin
ADMIN_PASSWORD_HASH=scrypt:reemplaza:reemplaza
