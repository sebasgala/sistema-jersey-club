# Copia este archivo como .env y reemplaza los valores. .env nunca se versiona.
POSTGRES_DB=jersey_club
POSTGRES_USER=jersey_admin
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_PORT=5436

